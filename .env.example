# Valores apenas para desenvolvimento local.
POSTGRES_DB=backend_challenge
POSTGRES_USER=challenge
POSTGRES_PASSWORD=challenge-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://challenge:challenge-local-only@localhost:5432/backend_challenge?sslmode=disable
HTTP_ADDR=:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
KEYCLOAK_PORT=8180
OIDC_ISSUER_URL=http://localhost:8180/realms/backend-challenge
OIDC_AUDIENCE=wager-api
TEST_OIDC_ISSUER_URL=http://localhost:8180/realms/backend-challenge
TEST_PROVIDER_CLIENT_SECRET=provider-a-local-secret
TEST_INTERNAL_CLIENT_SECRET=internal-service-local-secret

# Usada pelos testes de integração PostgreSQL após aplicar as migrations.
TEST_DATABASE_URL=postgres://challenge:challenge-local-only@localhost:5432/backend_challenge?sslmode=disable

# SQS local (LocalStack). A fila de eventos usa FIFO e deduplicação por eventId.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-events.fifo
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-events.fifo
SQS_INPUT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_MESSAGE_GROUP_ID=
OUTBOX_WORKER_ID=api-local
TEST_SQS_ENDPOINT=http://localhost:4566
TEST_SQS_INPUT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
TEST_SQS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
